{
  "advisor-kit": {
    "SessionStart": [
      { "type": "command", "command": "__HOOK__ SessionStart", "timeout": 10 }
    ],
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "__HOOK__ PreToolUse", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|invoke_subagent",
        "hooks": [
          { "type": "command", "command": "__HOOK__ PostToolUse", "timeout": 10 }
        ]
      }
    ],
    "PreInvocation": [
      { "type": "command", "command": "__HOOK__ PreInvocation", "timeout": 10 }
    ],
    "Stop": [
      { "type": "command", "command": "__HOOK__ Stop", "timeout": 15 }
    ]
  }
}
